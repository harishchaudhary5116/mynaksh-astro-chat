# ---------- LLM ----------
# Provider: gemini | anthropic | openai | fake
# "fake" runs the whole app with no API key at all (what the tests use).
LLM_PROVIDER=gemini

# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Model routing: a small cheap model extracts facts, a bigger one talks to the user.
LLM_CHAT_MODEL=gemini-flash-latest
LLM_EXTRACTION_MODEL=gemini-flash-lite-latest

# If you switch LLM_PROVIDER=anthropic, set these instead:
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_CHAT_MODEL=claude-opus-5-5
# LLM_EXTRACTION_MODEL=claude-haiku-4-5

# ---------- Shared Brain ----------
# Backend: memory | neo4j
# "memory" is a real graph (shared entity nodes, per-user edges, supersession)
# held in process. It runs the whole app with zero infrastructure.
BRAIN_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mynaksh123

# ---------- Memory tuning ----------
SHORT_TERM_TURNS=6          # how many recent turns stay in the session buffer
MAX_BRAIN_FACTS=5           # hard cap on long-term facts sent to the LLM
MIN_FACT_CONFIDENCE=0.6     # below this, an extracted fact is dropped
ASYNC_MEMORY_WRITE=true     # write memory after responding (set false in tests)
